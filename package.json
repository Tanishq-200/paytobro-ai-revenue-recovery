{
  "name": "paytobro",
  "version": "1.0.0",
  "description": "PayToBro — AI-Powered Revenue Recovery Platform",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,cyan\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "test": "npm test --prefix backend"
  },
  "keywords": ["fintech", "revenue-recovery", "ai-agent", "payments"],
  "author": "PayToBro Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
